# Full tilgang — brukt av migrasjoner, synkronisering og nettstedets vanlige spørringer.
# På Vercel settes denne av Neon-integrasjonen fra Marketplace.
DATABASE_URL=postgres://aafk:aafk-local@localhost:5432/aafkstats

# Skrivebeskyttet rolle for chattens run_sql. Egen tilkoblingsstreng med vilje:
# da er det umulig å ved et uhell kjøre en modellgenerert spørring som eier.
# Passordet må stemme med CHAT_DB_PASSWORD under migrering.
DATABASE_URL_READONLY=postgres://aafk_chat:chat-local-dev@localhost:5432/aafkstats
CHAT_DB_PASSWORD=chat-local-dev

# Claude API
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (bidragsskjemaet)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
