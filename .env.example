# Spørrefunksjonen. Sett ÉN av de to nøklene under; uten begge virker alt
# bortsett fra spørrefunksjonen, som svarer 503.
#
# Claude API (standard når begge er satt).
ANTHROPIC_API_KEY=
# OpenAI API. Alternativ, ikke tillegg — det er alltid én modell som svarer.
# OPENAI_API_KEY=

# Hvem som skal svare når begge nøklene er satt: anthropic eller openai.
# Utelates den, brukes anthropic.
# AAFK_CHAT_PROVIDER=

# Modell hos den valgte leverandøren. Utelates den, brukes claude-sonnet-5 hos
# Anthropic og gpt-5.6-terra hos OpenAI. Merk at kallet forutsetter tenkning og
# innsatsnivå; en eldre modell som mangler det, krever kodeendring.
# AAFK_CHAT_MODEL=

# Sti til den bygde arkivfilen. Utelates den, brukes apps/web/.data/aafkstats.sqlite.
# AAFK_DB_PATH=

# Hvilken datakatalog som bygges. Relativ til repo-rota.
# Sett til fixtures/data for testarkivet.
# AAFK_DATA_DIR=

# Cloudflare Turnstile (bidragsskjemaet, ikke bygget ennå)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Måling. Vercel Web Analytics og Speed Insights trenger ingen nøkler — de skrus
# på i Vercel-prosjektet. De to under gjelder bare hvis du i tillegg vil kjøre en
# Plausible-kompatibel teller. Tomt domene = av. Se «Måling» i README.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
