{
  "name": "aafkstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "validate": "pnpm --filter @aafkstats/schema run validate",
    "data:duplicates": "pnpm --filter @aafkstats/schema run duplicates",
    "data:uncertain": "pnpm --filter @aafkstats/schema run uncertain",
    "ingest:fotmob": "pnpm --filter @aafkstats/ingest run fotmob",
    "ingest:fotmob-gap": "pnpm --filter @aafkstats/ingest run fotmob-gap",
    "ingest:rsssf": "pnpm --filter @aafkstats/ingest run rsssf",
    "ingest:rsssf-standings": "pnpm --filter @aafkstats/ingest run rsssf-standings",
    "ingest:wikipedia-people": "pnpm --filter @aafkstats/ingest run wikipedia-people",
    "ingest:wikidata-people": "pnpm --filter @aafkstats/ingest run wikidata-people",
    "ingest:rsssf-discover": "pnpm --filter @aafkstats/ingest run rsssf-discover",
    "ingest:nff": "pnpm --filter @aafkstats/ingest run nff",
    "db:build": "pnpm --filter @aafkstats/db run build-archive",
    "typecheck": "tsc --build --force && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "pnpm --filter @aafkstats/web run dev",
    "build": "pnpm --filter @aafkstats/web run build",
    "smoke": "pnpm --filter @aafkstats/web run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.6"
  }
}
