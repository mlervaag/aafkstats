{
  "name": "aafkstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "pnpm --filter @aafkstats/schema run validate",
    "db:migrate": "pnpm --filter @aafkstats/db run migrate",
    "db:sync": "pnpm --filter @aafkstats/db run sync",
    "db:reset": "pnpm --filter @aafkstats/db run reset",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "pnpm --filter @aafkstats/web run dev",
    "build": "pnpm --filter @aafkstats/web run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
